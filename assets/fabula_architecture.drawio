        <!-- ==================== PHASE 2: COLUMN 2 (ENGINE & FIREWALL) ==================== -->
        <!-- Headless Simulation Engine Core -->
        <mxCell id="node_engine" value="&lt;div style=&quot;font-family:'Inter',system-ui,sans-serif; padding:2px;&quot;&gt;&lt;div style=&quot;font-size:9px; font-weight:800; color:#0F172A; letter-spacing:0.5px; text-transform:uppercase; margin-bottom:2px;&quot;&gt;AUTHORITATIVE RUNTIME&lt;/div&gt;&lt;div style=&quot;font-size:14px; font-weight:800; color:#0F172A;&quot;&gt;Headless Simulation Engine&lt;/div&gt;&lt;div style=&quot;font-size:10px; color:#64748B; margin-bottom:6px;&quot;&gt;Pure-Python Core &amp;bull; Zero UI Imports&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #CBD5E1; padding-top:6px; font-size:10.5px; line-height:1.55; color:#1E293B;&quot;&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Decoupled:&lt;/b&gt; 100% headless (zero UI dependencies)&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Session Clock:&lt;/b&gt; 1-minute real-time simulation ticks&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Perception Filter:&lt;/b&gt; Tile proximity vision radius&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b&gt;World State:&lt;/b&gt; Authoritative player &amp;amp; NPC positions&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Event Bus:&lt;/b&gt; Coordinates motion, talk &amp;amp; clue reveals&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Truth Custodian:&lt;/b&gt; Sole holder of &lt;b&gt;truth.json&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=2.2;align=left;spacingLeft=12;spacingRight=10;verticalAlign=top;spacingTop=8;arcSize=5;" vertex="1" parent="group_phase2">
