        <!-- ==================== PHASE 2: COLUMN 3 (THE BODY & THE VOICE) ==================== -->
        <!-- The Body (Classical AI) -->
        <mxCell id="group_body" value="&lt;div style=&quot;font-family:'Inter',system-ui,sans-serif; padding:2px;&quot;&gt;&lt;div style=&quot;font-size:9px; font-weight:800; color:#065F46; letter-spacing:0.5px; text-transform:uppercase; margin-bottom:2px;&quot;&gt;DETERMINISTIC AI&lt;/div&gt;&lt;div style=&quot;font-size:13px; font-weight:800; color:#065F46;&quot;&gt;The Body (Classical AI)&lt;/div&gt;&lt;div style=&quot;font-size:10px; color:#047857; margin-bottom:6px;&quot;&gt;Autonomous Navigation &amp;amp; Physical Rules&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #A7F3D0; padding-top:6px; font-size:10.5px; line-height:1.55; color:#064E3B;&quot;&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Authored Schedules:&lt;/b&gt; Waypoint table (&lt;i&gt;at_minute &amp;rarr; loc&lt;/i&gt;)&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b&gt;A* Shortest Path:&lt;/b&gt; Town graph G=(V,E) search&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Zero LLM Drift:&lt;/b&gt; 100% deterministic spatial moves&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Collision Rules:&lt;/b&gt; Tile occupancy &amp;amp; door keys&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Background Sim:&lt;/b&gt; NPCs navigate off-screen&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.8;align=left;spacingLeft=12;spacingRight=10;verticalAlign=top;spacingTop=8;arcSize=5;" vertex="1" parent="group_phase2">
          <mxGeometry x="670" y="50" width="280" height="250" as="geometry" />
        </mxCell>

        <!-- Arrow: Engine -> Body -->
        <mxCell id="edge_engine_body" value="Schedule Waypoints (at_minute)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontSize=10;fontColor=#065F46;fontFamily=Inter,system-ui,sans-serif;labelBackgroundColor=#FFFFFF;labelBorderColor=#A7F3D0;labelPadding=3;exitX=1;exitY=0.28;exitDx=0;exitDy=0;entryX=0;entryY=0.28;entryDx=0;entryDy=0;" edge="1" parent="group_phase2" source="node_engine" target="group_body">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: Body -> Engine -->
        <mxCell id="edge_body_engine" value="A* Tile Coordinates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;dashed=1;fontSize=10;fontColor=#065F46;fontFamily=Inter,system-ui,sans-serif;labelBackgroundColor=#FFFFFF;labelBorderColor=#A7F3D0;labelPadding=3;exitX=0;exitY=0.72;exitDx=0;exitDy=0;entryX=1;entryY=0.72;entryDx=0;entryDy=0;" edge="1" parent="group_phase2" source="group_body" target="node_engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- The Voice (Prompt Assembler) -->
        <mxCell id="group_voice" value="&lt;div style=&quot;font-family:'Inter',system-ui,sans-serif; padding:2px;&quot;&gt;&lt;div style=&quot;font-size:9px; font-weight:800; color:#5B21B6; letter-spacing:0.5px; text-transform:uppercase; margin-bottom:2px;&quot;&gt;SPEECH RUNTIME&lt;/div&gt;&lt;div style=&quot;font-size:13px; font-weight:800; color:#5B21B6;&quot;&gt;The Voice (Prompt Engine)&lt;/div&gt;&lt;div style=&quot;font-size:10px; color:#6D28D9; margin-bottom:6px;&quot;&gt;Per-NPC Dialogue Orchestration&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #DDD6FE; padding-top:6px; font-size:10.5px; line-height:1.55; color:#4C1D95;&quot;&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Isolated Assembly:&lt;/b&gt; Own identity &amp;amp; memory JSON&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Disclosure Rules:&lt;/b&gt; &lt;i&gt;volunteer &amp;bull; if_asked &amp;bull; hide &amp;bull; lie&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Cover Stories:&lt;/b&gt; Authored lies for culprit NPCs&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Dispatcher:&lt;/b&gt; Live API &amp;harr; Scripted fallback&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Parser:&lt;/b&gt; Strict {&quot;reply&quot;: str, &quot;mood&quot;: str}&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.8;align=left;spacingLeft=12;spacingRight=10;verticalAlign=top;spacingTop=8;arcSize=5;" vertex="1" parent="group_phase2">
          <mxGeometry x="670" y="400" width="280" height="175" as="geometry" />
        </mxCell>

        <!-- Arrow: Firewall -> Voice -->
        <mxCell id="edge_firewall_voice" value="Sanitized Memory DTO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;fontSize=10;fontColor=#5B21B6;fontFamily=Inter,system-ui,sans-serif;labelBackgroundColor=#FFFFFF;labelBorderColor=#DDD6FE;labelPadding=3;" edge="1" parent="group_phase2" source="node_firewall" target="group_voice">
          <mxGeometry relative="1" as="geometry" />
