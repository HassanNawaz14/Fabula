        <!-- Scripted Fallback -->
        <mxCell id="node_fallback" value="&lt;div style=&quot;font-family:'Inter',system-ui,sans-serif; padding:2px;&quot;&gt;&lt;div style=&quot;font-size:9px; font-weight:700; color:#475569; letter-spacing:0.5px; text-transform:uppercase; margin-bottom:2px;&quot;&gt;DETERMINISTIC FALLBACK&lt;/div&gt;&lt;div style=&quot;font-size:12.5px; font-weight:700; color:#0F172A;&quot;&gt;Scripted Dialogue Fallback&lt;/div&gt;&lt;div style=&quot;font-size:10px; color:#64748B; margin-bottom:5px;&quot;&gt;Authored Persona Templates&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #E2E8F0; padding-top:5px; font-size:10px; line-height:1.45; color:#334155;&quot;&gt;&lt;div&gt;&amp;bull; Zero API key needed (offline / timeout)&lt;/div&gt;&lt;div&gt;&amp;bull; Deterministic reveal of eligible clues&lt;/div&gt;&lt;div&gt;&amp;bull; Excluded from live provider evals&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;spacingTop=6;arcSize=5;" vertex="1" parent="group_phase2">
          <mxGeometry x="1010" y="525" width="245" height="105" as="geometry" />
        </mxCell>

        <!-- Arrows: Voice -> Providers -->
        <mxCell id="edge_voice_live" value="API Key Present" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=1.8;fontSize=10;fontColor=#0369A1;fontFamily=Inter,system-ui,sans-serif;labelBackgroundColor=#FFFFFF;labelBorderColor=#BAE6FD;labelPadding=3;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="group_phase2" source="group_voice" target="node_live_api">
