        <!-- ==================== PHASE 2: COLUMN 4 (SPEECH PROVIDERS) ==================== -->
        <!-- Live Cloud LLMs -->
        <mxCell id="node_live_api" value="&lt;div style=&quot;font-family:'Inter',system-ui,sans-serif; padding:2px;&quot;&gt;&lt;div style=&quot;font-size:9px; font-weight:700; color:#0369A1; letter-spacing:0.5px; text-transform:uppercase; margin-bottom:2px;&quot;&gt;EXTERNAL PROVIDER&lt;/div&gt;&lt;div style=&quot;font-size:12.5px; font-weight:700; color:#0F172A;&quot;&gt;Live LLM Providers&lt;/div&gt;&lt;div style=&quot;font-size:10px; color:#64748B; margin-bottom:5px;&quot;&gt;Gemini 2.5 &amp;bull; xAI Grok&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #E2E8F0; padding-top:5px; font-size:10px; line-height:1.45; color:#334155;&quot;&gt;&lt;div&gt;&amp;bull; Target SLA: &amp;asymp; 2–3s latency cap&lt;/div&gt;&lt;div&gt;&amp;bull; Budget: Per-session token caps&lt;/div&gt;&lt;div&gt;&amp;bull; Grounded roleplay within memory&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;spacingTop=6;arcSize=5;" vertex="1" parent="group_phase2">
          <mxGeometry x="1010" y="400" width="245" height="105" as="geometry" />
