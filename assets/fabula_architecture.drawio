        <!-- The Spoiler Firewall (Security Boundary) -->
        <mxCell id="node_firewall" value="&lt;div style=&quot;font-family:'Inter',system-ui,sans-serif; padding:2px;&quot;&gt;&lt;div style=&quot;font-size:9px; font-weight:800; color:#991B1B; letter-spacing:0.5px; text-transform:uppercase; margin-bottom:2px;&quot;&gt;SECURITY BOUNDARY&lt;/div&gt;&lt;div style=&quot;font-size:13px; font-weight:800; color:#B91C1C;&quot;&gt;The Spoiler Firewall&lt;/div&gt;&lt;div style=&quot;font-size:10px; color:#991B1B; margin-bottom:6px;&quot;&gt;Machine-Enforced Isolation Gateway&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #FECACA; padding-top:6px; font-size:10.5px; line-height:1.55; color:#7F1D1D;&quot;&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Strict Barrier:&lt;/b&gt; &lt;b&gt;truth.json&lt;/b&gt; is strictly engine-only&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Zero Injection:&lt;/b&gt; Never sent in prompts or API calls&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Per-NPC Memory:&lt;/b&gt; NPC prompts read only own facts&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b&gt;Test-Verified:&lt;/b&gt; Enforced by tests, not prompt wording&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=1.8;align=left;spacingLeft=12;spacingRight=10;verticalAlign=top;spacingTop=8;arcSize=5;" vertex="1" parent="group_phase2">
