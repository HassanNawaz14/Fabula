        <!-- Arrow: Voice -> Fallback -->
        <mxCell id="edge_voice_fb" value="No Key / Offline / Timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.8;fontSize=10;fontColor=#475569;fontFamily=Inter,system-ui,sans-serif;labelBackgroundColor=#FFFFFF;labelBorderColor=#E2E8F0;labelPadding=3;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="group_phase2" source="group_voice" target="node_fallback">
