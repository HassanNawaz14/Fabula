        <!-- Arrow: Voice -> Engine (Dialogue speech event returning through open corridor) -->
        <mxCell id="edge_speech_engine" value="Speech Event DTO {reply, mood}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=1.5;dashed=1;fontSize=10;fontColor=#5B21B6;fontFamily=Inter,system-ui,sans-serif;labelBackgroundColor=#FFFFFF;labelBorderColor=#DDD6FE;labelPadding=3;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="group_phase2" source="group_voice" target="node_engine">
          <mxGeometry relative="1" as="geometry">
